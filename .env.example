# See CURSOR_RULES.md
# Copy to .env and fill in your Google OAuth credentials.
# Required for YouTube playlist export. Get credentials at:
# https://console.cloud.google.com/ → APIs & Services → Credentials

YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret

# Optional. Defaults to http://localhost:8080/api/auth/youtube/callback for local dev.
# REDIRECT_URI=https://your-domain.com/api/auth/youtube/callback
