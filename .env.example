# See CURSOR_RULES.md
# Copy to .env and fill in your Google OAuth credentials.
# Required for YouTube playlist export. Get credentials at:
# https://console.cloud.google.com/ → APIs & Services → Credentials

YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret

# Optional. Defaults to http://localhost:8080/api/auth/youtube/callback for local dev.
# On Vercel, defaults to https://$VERCEL_URL/api/auth/youtube/callback if unset.
# REDIRECT_URI=https://your-app.vercel.app/api/auth/youtube/callback

# Optional. Used to encrypt OAuth cookies on Vercel. Falls back to YOUTUBE_CLIENT_SECRET.
# SESSION_SECRET=generate-a-long-random-string
